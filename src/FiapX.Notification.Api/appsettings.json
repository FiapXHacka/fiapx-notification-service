{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=notification_db;Username=notification_svc"
  },
  "RabbitMq": {
    "Uri": "amqp://localhost:5672/",
    "ClientName": "notification-service",
    "Exchange": "fiapx.events",
    "DeadLetterExchange": "fiapx.dlx",
    "PrefetchCount": 16,
    "ConsumerConcurrency": 4,
    "MaxHandlerAttempts": 3,
    "HandlerRetryDelay": "00:00:00.200"
  },
  "Auth": {
    "Issuer": "http://localhost:8080",
    "Audience": "fiapx-api",
    "MetadataAddress": "http://localhost:8091/.well-known/openid-configuration",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
