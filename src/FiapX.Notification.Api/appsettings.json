{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=notification_db;Username=notification_svc;Password=notification_svc"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "ConsumerName": "notification-service",
    "Queue": "notification-service.events",
    "DeliveryLimit": 5,
    "Prefetch": 10
  },
  "Auth": {
    "JwksUrl": "http://localhost:8081/.well-known/jwks.json",
    "Issuer": "fiapx-identity",
    "Audience": "fiapx-api",
    "RequireHttpsMetadata": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
